{
  "manifest_version": 3,
  "name": "YouTube Account Switcher",
  "version": "2.0.0",
  "description": "Use your preferred signed-in Google account on YouTube, with configurable routing and account reconnection help.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "101",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Account Switcher"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/oops*"
      ],
      "js": [
        "recovery.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
